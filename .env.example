# Copie para .env e preencha. NUNCA versione o .env.
# Carregue com:  set -a; source .env; set +a

# --- Geral ---
DOCENTE_HOME=.                        # raiz de dados/logs (padrão: pasta atual)
PYTHONPATH=core:seguranca:cli_gestao:geradores_pedagogicos
ESCOLA_DB=                            # opcional; padrão: $DOCENTE_HOME/escola.db
MODO_VPS_LEVE=0
MODO_TESTE_ZAP=0                      # 1 = não envia mensagens (testes)

# --- OpenWA (WhatsApp) ---
OPENWA_API_URL=http://127.0.0.1:2785
OPENWA_API_KEY=COLOQUE_SUA_CHAVE_AQUI
OPENWA_SESSION_ID=

# --- Identidade do dono e autorizações ---
DONO_CHAT_ID=                         # seu chat, ex.: 5599XXXXXXXXX@c.us
CHAT_PRIVADO_PADRAO=
NUMERO_PROPRIETARIO=
LID_PROPRIETARIO=
WHATSAPP_AUTORIZADOS=                 # números/LIDs autorizados, separados por vírgula
WHATSAPP_LID_MAP={}                   # JSON {"<lid>@lid": "<numero>@c.us"}
WHATSAPP_PRIVADO_PEDRO=               # um por docente: WHATSAPP_PRIVADO_<CHAVE>
WHATSAPP_PRIVADO_LEANDRO=
WHATSAPP_PRIVADO_BRUNA=

# --- Grupos de WhatsApp (ids terminando em @g.us) ---
ID_GRUPO_BASE_TECNICA=
ID_GRUPO_ALUNOS_SEQUESTRO=
ID_GRUPO_CLUBE_PROGRAMACAO=
ID_GRUPO_INFRA_REDTEAM=
GRUPO_TURMA_200=
GRUPO_TURMA_201=
GRUPO_TURMA_202=
GRUPO_TURMA_203=

# --- LLM / gateway ---
OMNIROUTE_URL=
OMNIROUTE_MODEL=
OPENROUTER_API_KEY=
DESABILITAR_LEITURA_IMAGEM_OMNIROUTE=0

# --- Opcionais ---
HOST_LOCAL_WEBHOOK_URL=
TAILSCALE_IP=
TTL_SESSAO_PRIVADO_SEG=
INSTAGRAM_SESSION_ID=
TOUTATIS_SESSION_ID=
FORCAR_SYNC_TESTE=0
